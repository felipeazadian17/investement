# SEC asks automated clients to identify a person and contact email.
SEC_IDENTITY="Your Name your.email@example.com"

# Create a key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=""

# Market feed selection for monthly validation:
# auto uses Alpha Vantage only when the key above is configured, otherwise Yahoo.
MARKET_DATA_SOURCE="auto"
MARKET_DATA_CROSS_CHECK="none"
ALPHA_VANTAGE_OUTPUTSIZE="full"

# Weekly Sunday report. For Outlook/Hotmail, use an app password if required.
SMTP_HOST="smtp-mail.outlook.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
WEEKLY_REPORT_TO=""

# Optional JSON list overriding the default RSS/Atom feeds.
# NEWS_FEEDS_JSON='[{"name":"source","url":"https://example.com/feed.xml","weight":1}]'

# Vercel dashboard: server-side SnapTrade read-only portfolio import.
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
PORTFOLIO_BASE_CURRENCY="USD"
PORTFOLIO_BENCHMARK="SPY"
